#!/bin/bash

PLATFORM="android"
DEFAULT_UI="glw"
CONFIGURE_POSTFIX="android"

source support/configure.inc

SDK="${ANDROID_HOME}"

BUILD_TOOLS=27.0.3


show_help(){
  common_help
  echo "  --sdk=PREFIX          Use Android SDK from this path [$SDK]"
  echo "  --ndk=DIR             Use Android NDK from this path [$SDK/ndk-bundle]"
  echo "  --kind=KIND           Build for specific android configuration"
  echo "                        api16_armv7  ARMv7 SDK version 16 (4.1)"
  echo "                        api16_x86      x86 SDK version 16 (4.1)"
  echo "                        api21_arm64   ARMv8/ARMv9 (AArch64) SDK version 21 (5.0)"
  exit 1
}

enable sqlite_internal
enable sqlite_vfs
enable glw_backend_opengl_es
enable glw
disable librtmp
enable httpserver
enable libfreetype
enable stdin
enable mbedtls
enable vmir
disable upgrade

[ -f project.config ] && source project.config

# Process command line options first to get SDK/NDK paths
for opt do
    optval="${opt#*=}"
    case "$opt" in
        --ndk=*)
            NDK="$optval"
            ;;
        --sdk=*)
            SDK="$optval"
            ;;
    esac
done

# Clean up paths
if [ -n "${NDK}" ]; then
    NDK=${NDK%/}
fi
if [ -n "${SDK}" ]; then
    SDK=${SDK%/}
fi

export NDK
export SDK

# Now process all options
for opt do
    optval="${opt#*=}"
    case "$opt" in
        --help)
            show_help
            ;;
        --ndk=*)
            # Already processed above
            ;;
        --sdk=*)
            # Already processed above
            ;;
        --kind=api16_armv7)
            ANDROID_MIN_SDK_VERSION=16
            ANDROID_TARGET_SDK_VERSION=27
            ANDROID_BUILDKIND_DESCRIMINATOR=1
            ANDROID_ABI=armeabi-v7a
            BUILD=android.api${ANDROID_MIN_SDK_VERSION}_armv7
            TOOLCHAIN=${NDK}/toolchains/llvm/prebuilt/linux-x86_64/bin/armv7a-linux-androideabi${ANDROID_MIN_SDK_VERSION}-
            # Use llvm tools directly (versioned symlinks don't exist in r23b)
            export AR=${NDK}/toolchains/llvm/prebuilt/linux-x86_64/bin/llvm-ar
            export RANLIB=${NDK}/toolchains/llvm/prebuilt/linux-x86_64/bin/llvm-ranlib
            export NM=${NDK}/toolchains/llvm/prebuilt/linux-x86_64/bin/llvm-nm
            export STRIP=${NDK}/toolchains/llvm/prebuilt/linux-x86_64/bin/llvm-strip
            ARCH_CFLAGS="-march=armv7-a -mfloat-abi=softfp -mfpu=neon -funwind-tables -fPIC"
            ARCH_LDFLAGS="-march=armv7-a -Wl,--fix-cortex-a8"
            FFMPEG_ARCH_FLAGS="--cross-prefix=${TOOLCHAIN} --enable-cross-compile --arch=armv7 --target-os=android --enable-shared --disable-static --as=${TOOLCHAIN}as --nm=${NM} --strip=${STRIP} --disable-asm --disable-inline-asm"
            CC=${TOOLCHAIN}clang
            CXX=${TOOLCHAIN}clang++
            ;;
        --kind=api16_x86)
            ANDROID_MIN_SDK_VERSION=15
            ANDROID_TARGET_SDK_VERSION=21
            ANDROID_BUILDKIND_DESCRIMINATOR=2
            ANDROID_ABI=x86
            BUILD=android.api${ANDROID_MIN_SDK_VERSION}_x86
            TOOLCHAIN=${NDK}/toolchains/llvm/prebuilt/linux-x86_64/bin/i686-linux-android${ANDROID_MIN_SDK_VERSION}-
            ARCH_CFLAGS="-fPIC"
            FFMPEG_ARCH_FLAGS="--cross-prefix=${TOOLCHAIN} --enable-cross-compile --arch=x86 --target-os=android --enable-shared --disable-static --as=${TOOLCHAIN}as --disable-asm --disable-inline-asm"
            CC="${TOOLCHAIN}clang -mstackrealign"
            CXX="${TOOLCHAIN}clang++ -mstackrealign"
            ;;
        --kind=api21_arm64)
            ANDROID_MIN_SDK_VERSION=21
            ANDROID_TARGET_SDK_VERSION=27
            ANDROID_BUILDKIND_DESCRIMINATOR=3
            ANDROID_ABI=arm64-v8a
            BUILD=android.api${ANDROID_MIN_SDK_VERSION}_arm64
            TOOLCHAIN=${NDK}/toolchains/llvm/prebuilt/linux-x86_64/bin/aarch64-linux-android${ANDROID_MIN_SDK_VERSION}-
            # Use llvm tools directly
            export AR=${NDK}/toolchains/llvm/prebuilt/linux-x86_64/bin/llvm-ar
            export RANLIB=${NDK}/toolchains/llvm/prebuilt/linux-x86_64/bin/llvm-ranlib
            export NM=${NDK}/toolchains/llvm/prebuilt/linux-x86_64/bin/llvm-nm
            export STRIP=${NDK}/toolchains/llvm/prebuilt/linux-x86_64/bin/llvm-strip
            ARCH_CFLAGS="-march=armv8-a -funwind-tables -fPIC"
            ARCH_LDFLAGS="-march=armv8-a"
            FFMPEG_ARCH_FLAGS="--cross-prefix=${TOOLCHAIN} --enable-cross-compile --arch=aarch64 --target-os=android --enable-shared --disable-static --as=${TOOLCHAIN}as --nm=${NM} --strip=${STRIP} --disable-asm --disable-inline-asm"
            CC=${TOOLCHAIN}clang
            CXX=${TOOLCHAIN}clang++
            ;;
        *)
            common_opt $opt $optval
    esac
done

if [ -z "${ANDROID_BUILDKIND_DESCRIMINATOR}" ]; then
    echo "Android build kind not set (--kind option)"
    echo "See ./configure.android --help"
    die
fi

if [ -z "${SDK}" ]; then
    echo "Android SDK not set"
    echo "Either specify path to SDK using --sdk=/path/to/sdk"
    echo " OR "
    echo "Set ANDROID_HOME environment variable"
    die
fi

echo "Using Android SDK at : ${SDK}"
echo

if [ -z "${NDK}" ]; then
    NDK=${SDK}/ndk-bundle
fi

export NDK
export SDK

setup_env "$@"

echo "Using Android NDK at : ${NDK}"
stat "${NDK}"
echo

if [ ! -f "${CC}" ]; then
    echo "Toolchain not found at ${CC}"
    echo "NDK toolchain location: ${NDK}/toolchains/llvm/prebuilt/linux-x86_64/bin/"
    die
fi


bzip2_setup
PKG_CONFIG="" PKG_CONFIG_PATH="" freetype_setup --host=armv7a-linux-androideabi --without-brotli --with-png=no --with-harfbuzz=no

FFMPEG_CFLAGS="-I${EXT_INSTALL_DIR}/include ${ARCH_CFLAGS}"
FFMPEG_LDFLAGS="-L${EXT_INSTALL_DIR}/lib  ${ARCH_LDFLAGS}"

ext_setup
libyuv_setup

cat >> ${CONFIG_MAK} <<EOF
CFLAGS_arch = ${ARCH_CFLAGS}
CFLAGS_cfg += ${ARCH_CFLAGS}
LDFLAGS_cfg += ${ARCH_LDFLAGS} -lOpenSLES -lGLESv2 -llog -landroid -ljnigraphics
AR = ${AR}
RANLIB = ${RANLIB}
NM = ${NM}
STRIP = ${STRIP}
# Disable GCC-specific warnings for Clang
CFLAGS_cfg += -Wno-unknown-warning-option
ANDROID_BUILD_TOOLS := ${SDK}/build-tools/${BUILD_TOOLS}
ANDROID_PLATFORM_PATH := ${SDK}/platforms/android-${ANDROID_TARGET_SDK_VERSION}
ANDROID_BUILDKIND_DESCRIMINATOR := ${ANDROID_BUILDKIND_DESCRIMINATOR}
ANDROID_MIN_SDK_VERSION := ${ANDROID_MIN_SDK_VERSION}
ANDROID_TARGET_SDK_VERSION := ${ANDROID_TARGET_SDK_VERSION}
ANDROID_ABI := ${ANDROID_ABI}
EOF

finalize
